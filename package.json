{
  "name": "latentia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter @latentia/engine test",
    "test:browser": "pnpm --filter @latentia/engine test:browser",
    "bench": "pnpm --filter @latentia/engine bench",
    "golden:record": "pnpm --filter @latentia/engine golden:record",
    "sim": "pnpm --filter @latentia/sim sim"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
